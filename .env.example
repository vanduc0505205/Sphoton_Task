# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"

# JWT Secrets (Replace with your own secrets in .env)
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_KEY
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_KEY

# Super Admin Seed Account
SUPER_ADMIN_EMAIL=YOUR_SUPER_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=YOUR_SUPER_ADMIN_PASSWORD
SUPER_ADMIN_NAME="Super Admin Sphoton"

# Optional Demo Accounts for Development Seed
DEMO_ADMIN_EMAIL=YOUR_DEMO_ADMIN_EMAIL
DEMO_USER_EMAIL=YOUR_DEMO_USER_EMAIL
DEMO_ACCOUNT_PASSWORD=YOUR_DEMO_ACCOUNT_PASSWORD

# SMTP Email Configuration (Mailpit / Ethereal / Custom SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM="SphotonTask <no-reply@sphoton.local>"

# Client Configuration
VITE_API_URL=http://localhost:4000/api
